# Optional: URL of the deployed Cloudflare Worker that stores anonymous daily scores.
#
# When this is set, Spectra submits your score and shows the REAL "you beat X% of
# players today" ranking + today's distribution curve.
#
# When it is empty or the worker is unreachable, the game falls back to a built-in
# offline estimate so it stays fully playable with no backend at all.
#
# Example:  VITE_API_URL=https://spectra-api.your-subdomain.workers.dev
VITE_API_URL=
